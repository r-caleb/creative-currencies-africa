generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  PUBLIC
  CREATOR
  LEARNER
  ORGANIZATION
  PARTNER
  ADMIN
}

enum AccountStatus {
  PENDING
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum AuthProvider {
  GOOGLE
  APPLE
  FACEBOOK
}

enum VerificationPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum Gender {
  FEMALE
  MALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum ProfileVisibility {
  PRIVATE
  MEMBERS
  PUBLIC
}

enum ResourceType {
  PDF
  TEMPLATE
  CONTRACT
  GUIDE
  VIDEO
  PODCAST
}

enum ResourceAccessLevel {
  PUBLIC
  MEMBERS
  ENROLLED
  ADMIN_ONLY
}

enum TrainingStatus {
  DRAFT
  PUBLISHED
  COMPLETED
  ARCHIVED
}

enum EnrollmentStatus {
  ENROLLED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OpportunityType {
  CONTEST
  RESIDENCY
  MISSION
  FUNDING
  CASTING
  FESTIVAL
  TRAINING
}

enum OpportunityStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  SELECTED
  REJECTED
  WITHDRAWN
}

enum EventType {
  WORKSHOP
  MASTERCLASS
  CONFERENCE
  PANEL
  ACTIVATION
  VISIT
  FESTIVAL
}

enum EventRegistrationStatus {
  REGISTERED
  ATTENDED
  CANCELLED
}

enum CertificateStatus {
  PENDING
  ISSUED
  REVOKED
}

enum NotificationType {
  SYSTEM
  TRAINING
  OPPORTUNITY
  CERTIFICATE
  MESSAGE
}

enum PublicationType {
  PROJECT
  CREATION
  QUESTION
  COLLABORATION
  OPPORTUNITY
  JOB
  RESOURCE
  GROUP_DISCUSSION
  TRAINING
  EVENT
  ANNOUNCEMENT
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  REJECTED
}

enum PublicationAudience {
  PRIVATE
  MEMBERS
  PUBLIC
  GROUP
}

enum PublicationAttachmentType {
  IMAGE
  VIDEO
  PDF
  DOCUMENT
  LINK
  OTHER
}

enum PublicationReactionType {
  LIKE
  SUPPORT
  SAVE
}

enum PublicationReportReason {
  SPAM
  INAPPROPRIATE
  MISLEADING
  HARASSMENT
  OTHER
}

enum PublicationReportStatus {
  PENDING
  REVIEWED
  DISMISSED
}

enum CommunityGroupStatus {
  ACTIVE
  ARCHIVED
}

enum CommunityGroupVisibility {
  MEMBERS
  PUBLIC
  PRIVATE
}

enum CommunityGroupRole {
  OWNER
  MODERATOR
  MEMBER
}

enum CommunityGroupInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum CommunityGroupMessageType {
  TEXT
  FILE
  SYSTEM
}

enum NetworkConnectionKind {
  CONNECTION
  FOLLOW
}

enum NetworkConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
}

model User {
  id              String        @id @default(cuid())
  email           String        @unique
  passwordHash    String?
  firstName       String
  lastName        String
  phone           String?
  type            AccountType   @default(LEARNER)
  status          AccountStatus @default(PENDING)
  emailVerifiedAt DateTime?

  sessions                      AuthSession[]
  identities                    UserIdentity[]
  verificationTokens            VerificationToken[]
  profile                       CreativeProfile?
  organizationProfile           OrganizationProfile?
  partnerProfile                PartnerProfile?
  portfolioItems                PortfolioItem[]
  enrollments                   TrainingEnrollment[]
  opportunityApplications       OpportunityApplication[]
  eventRegistrations            EventRegistration[]
  certificates                  Certificate[]
  uploadedResources             Resource[]                      @relation("ResourceUploader")
  notifications                 Notification[]
  publications                  Publication[]                   @relation("PublicationAuthor")
  publicationComments           PublicationComment[]
  publicationReactions          PublicationReaction[]
  publicationShares             PublicationShare[]
  publicationReports            PublicationReport[]             @relation("PublicationReporter")
  publicationMentions           PublicationMention[]
  networkConnections            NetworkConnection[]             @relation("NetworkConnectionOwner")
  networkSavedBy                NetworkConnection[]             @relation("NetworkConnectionMember")
  communityGroupsOwned          CommunityGroup[]                @relation("CommunityGroupOwner")
  communityGroupMemberships     CommunityGroupMembership[]
  communityGroupMessages        CommunityGroupMessage[]
  communityGroupInvitesSent     CommunityGroupInvitation[]      @relation("CommunityGroupInvitationInviter")
  communityGroupInvitesReceived CommunityGroupInvitation[]      @relation("CommunityGroupInvitationInvitee")
  directConversationsCreated    DirectConversation[]            @relation("DirectConversationCreator")
  directConversationMemberships DirectConversationParticipant[]
  directMessages                DirectMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

model AuthSession {
  id     String @id @default(cuid())
  userId String

  refreshTokenHash String
  previousHash     String?
  rotatedAt        DateTime?
  deviceId         String?
  userAgent        String?
  ip               String?
  expiresAt        DateTime
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([revokedAt])
  @@index([expiresAt])
}

model UserIdentity {
  id     String @id @default(cuid())
  userId String

  provider       AuthProvider
  providerUserId String

  providerEmail         String?
  providerEmailVerified Boolean @default(false)
  providerDisplayName   String?
  providerPhotoUrl      String?

  linkedAt   DateTime  @default(now())
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId], name: "user_identity_provider_provider_user_id_unique")
  @@unique([userId, provider], name: "user_identity_user_provider_unique")
  @@index([userId])
  @@index([provider, providerEmail])
}

model VerificationToken {
  id     String  @id @default(cuid())
  userId String?
  email  String

  purpose     VerificationPurpose
  tokenHash   String
  attempts    Int                 @default(0)
  maxAttempts Int                 @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email, purpose])
  @@index([expiresAt])
  @@index([consumedAt])
}

model Discipline {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

model CreativeProfile {
  id                String            @id @default(cuid())
  userId            String            @unique
  publicName        String?
  country           String
  city              String
  profession        String?
  birthDate         DateTime?
  gender            Gender?
  discipline        String
  otherDiscipline   String?
  bio               String?
  portfolioUrl      String?
  websiteUrl        String?
  avatarUrl         String?
  // CV optionnel du créatif, utile pour les appels à projets, résidences et candidatures.
  cvUrl             String?
  memberNumber      String            @unique
  qrCodeUrl         String?
  skills            String[]          @default([])
  languages         String[]          @default([])
  availability      String?
  visibility        ProfileVisibility @default(MEMBERS)
  profileCompletion Int               @default(0)
  verifiedAt        DateTime?

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  socialLinks SocialLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([country, city])
  @@index([discipline])
  @@index([visibility])
}

model OrganizationProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  name        String
  legalName   String?
  sector      String?
  country     String
  city        String
  websiteUrl  String?
  logoUrl     String?
  description String?
  verifiedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PartnerProfile {
  id          String    @id @default(cuid())
  userId      String    @unique
  name        String
  partnerType String
  country     String
  city        String?
  websiteUrl  String?
  logoUrl     String?
  description String?
  verifiedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SocialLink {
  id        String @id @default(cuid())
  profileId String
  network   String
  url       String

  profile CreativeProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([profileId, network])
}

model PortfolioItem {
  id          String  @id @default(cuid())
  userId      String
  title       String
  description String?
  category    String
  mediaUrl    String?
  externalUrl String?
  year        Int?
  featured    Boolean @default(false)
  order       Int     @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([category])
}

model Training {
  id                 String         @id @default(cuid())
  title              String
  slug               String         @unique
  description        String
  startsAt           DateTime?
  endsAt             DateTime?
  location           String?
  coverImageUrl      String?
  capacity           Int?
  priceCents         Int?
  currency           String         @default("USD")
  status             TrainingStatus @default(DRAFT)
  certificateEnabled Boolean        @default(true)

  modules      TrainingModule[]
  enrollments  TrainingEnrollment[]
  resources    Resource[]
  certificates Certificate[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([startsAt])
}

model TrainingModule {
  id          String    @id @default(cuid())
  trainingId  String
  title       String
  description String?
  order       Int       @default(0)
  startsAt    DateTime?
  endsAt      DateTime?

  training Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([trainingId])
}

model TrainingEnrollment {
  id          String           @id @default(cuid())
  trainingId  String
  userId      String
  status      EnrollmentStatus @default(ENROLLED)
  progress    Int              @default(0)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?

  training Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([trainingId, userId])
  @@index([userId])
  @@index([status])
}

model Resource {
  id           String              @id @default(cuid())
  title        String
  description  String?
  type         ResourceType
  url          String
  accessLevel  ResourceAccessLevel @default(MEMBERS)
  published    Boolean             @default(false)
  trainingId   String?
  uploadedById String?

  training   Training? @relation(fields: [trainingId], references: [id], onDelete: SetNull)
  uploadedBy User?     @relation("ResourceUploader", fields: [uploadedById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([accessLevel])
  @@index([published])
  @@index([trainingId])
}

model Opportunity {
  id             String            @id @default(cuid())
  title          String
  slug           String            @unique
  description    String
  type           OpportunityType
  status         OpportunityStatus @default(DRAFT)
  deadline       DateTime?
  location       String?
  eligibilityUrl String?
  published      Boolean           @default(false)

  applications OpportunityApplication[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([deadline])
  @@index([published])
}

model OpportunityApplication {
  id            String            @id @default(cuid())
  opportunityId String
  userId        String
  status        ApplicationStatus @default(DRAFT)
  motivation    String?
  portfolioUrl  String?
  submittedAt   DateTime?
  reviewedAt    DateTime?
  adminNote     String?

  opportunity Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([opportunityId, userId])
  @@index([userId])
  @@index([status])
}

model Event {
  id               String    @id @default(cuid())
  title            String
  slug             String    @unique
  description      String
  type             EventType @default(WORKSHOP)
  startsAt         DateTime
  endsAt           DateTime
  location         String
  coverImageUrl    String?
  whatsappUrl      String?
  facebookEventUrl String?
  published        Boolean   @default(false)

  registrations EventRegistration[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([startsAt])
  @@index([published])
}

model EventRegistration {
  id           String                  @id @default(cuid())
  eventId      String
  userId       String
  status       EventRegistrationStatus @default(REGISTERED)
  registeredAt DateTime                @default(now())
  attendedAt   DateTime?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@index([status])
}

model Certificate {
  id         String            @id @default(cuid())
  userId     String
  trainingId String?
  title      String
  number     String            @unique
  status     CertificateStatus @default(PENDING)
  issuedAt   DateTime?
  expiresAt  DateTime?
  fileUrl    String?
  badgeUrl   String?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  training Training? @relation(fields: [trainingId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([trainingId])
  @@index([status])
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String?
  website   String?
  order     Int      @default(0)
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published])
  @@index([order])
}

model Notification {
  id      String           @id @default(cuid())
  userId  String
  type    NotificationType @default(SYSTEM)
  title   String
  message String
  href    String?
  readAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([readAt])
  @@index([createdAt])
}

model NetworkConnection {
  id          String                  @id @default(cuid())
  ownerId     String
  memberId    String
  kind        NetworkConnectionKind   @default(CONNECTION)
  status      NetworkConnectionStatus @default(ACCEPTED)
  note        String?
  respondedAt DateTime?

  owner  User @relation("NetworkConnectionOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  member User @relation("NetworkConnectionMember", fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([ownerId, memberId])
  @@index([ownerId])
  @@index([memberId])
  @@index([kind])
  @@index([status])
  @@index([createdAt])
}

model DirectConversation {
  id             String   @id @default(cuid())
  participantKey String   @unique
  createdById    String?
  lastMessageAt  DateTime @default(now())

  createdBy    User?                           @relation("DirectConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  participants DirectConversationParticipant[]
  messages     DirectMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
  @@index([lastMessageAt])
  @@index([createdAt])
}

model DirectConversationParticipant {
  id             String    @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  archivedAt     DateTime?

  conversation DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([conversationId, userId])
  @@index([userId])
  @@index([lastReadAt])
}

model DirectMessage {
  id                 String    @id @default(cuid())
  conversationId     String
  authorId           String
  content            String
  attachmentUrl      String?
  attachmentName     String?
  attachmentMimeType String?
  editedAt           DateTime?
  deletedAt          DateTime?

  conversation DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User               @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([conversationId, createdAt])
  @@index([authorId])
  @@index([deletedAt])
}

model Publication {
  id       String @id @default(cuid())
  authorId String

  type     PublicationType
  status   PublicationStatus   @default(DRAFT)
  audience PublicationAudience @default(MEMBERS)

  title   String
  content String
  excerpt String?

  category            String?
  discipline          String?
  country             String?
  city                String?
  tags                String[] @default([])
  routingDestinations String[] @default([])

  linkUrl             String?
  coverImageUrl       String?
  groupId             String?
  opportunityDeadline DateTime?
  opportunityLocation String?
  budgetRange         String?
  contactEmail        String?

  publishedAt DateTime?
  expiresAt   DateTime?

  author      User                    @relation("PublicationAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  attachments PublicationAttachment[]
  comments    PublicationComment[]
  reactions   PublicationReaction[]
  shares      PublicationShare[]
  reports     PublicationReport[]
  mentions    PublicationMention[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([type])
  @@index([status])
  @@index([audience])
  @@index([category])
  @@index([publishedAt])
  @@index([createdAt])
}

model PublicationMention {
  id            String @id @default(cuid())
  publicationId String
  userId        String

  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([publicationId, userId])
  @@index([publicationId])
  @@index([userId])
  @@index([createdAt])
}

model PublicationAttachment {
  id            String                    @id @default(cuid())
  publicationId String
  type          PublicationAttachmentType @default(OTHER)
  url           String
  name          String?
  mimeType      String?
  sizeBytes     Int?
  order         Int                       @default(0)

  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([publicationId])
  @@index([type])
}

model PublicationComment {
  id            String  @id @default(cuid())
  publicationId String
  authorId      String
  parentId      String?
  content       String

  publication Publication          @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  author      User                 @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent      PublicationComment?  @relation("PublicationCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     PublicationComment[] @relation("PublicationCommentReplies")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([publicationId])
  @@index([authorId])
  @@index([parentId])
  @@index([createdAt])
}

model PublicationReaction {
  id            String                  @id @default(cuid())
  publicationId String
  userId        String
  type          PublicationReactionType @default(LIKE)

  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([publicationId, userId, type])
  @@index([publicationId])
  @@index([userId])
  @@index([type])
}

model PublicationShare {
  id            String  @id @default(cuid())
  publicationId String
  userId        String
  content       String?

  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([publicationId, userId])
  @@index([publicationId])
  @@index([userId])
  @@index([createdAt])
}

model PublicationReport {
  id            String                  @id @default(cuid())
  publicationId String
  reporterId    String
  reason        PublicationReportReason
  message       String?
  status        PublicationReportStatus @default(PENDING)
  reviewedAt    DateTime?

  publication Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  reporter    User        @relation("PublicationReporter", fields: [reporterId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([publicationId, reporterId])
  @@index([publicationId])
  @@index([reporterId])
  @@index([reason])
  @@index([status])
  @@index([createdAt])
}

model CommunityGroup {
  id          String                   @id @default(cuid())
  ownerId     String
  name        String
  slug        String                   @unique
  category    String
  description String
  avatarUrl   String?
  city        String?
  country     String?
  tags        String[]                 @default([])
  visibility  CommunityGroupVisibility @default(MEMBERS)
  status      CommunityGroupStatus     @default(ACTIVE)

  owner       User                       @relation("CommunityGroupOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  memberships CommunityGroupMembership[]
  messages    CommunityGroupMessage[]
  invitations CommunityGroupInvitation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([category])
  @@index([city])
  @@index([createdAt])
}

model CommunityGroupMembership {
  id         String             @id @default(cuid())
  groupId    String
  userId     String
  role       CommunityGroupRole @default(MEMBER)
  lastReadAt DateTime?

  group CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([groupId, userId])
  @@index([userId])
  @@index([role])
  @@index([lastReadAt])
}

model CommunityGroupInvitation {
  id        String                         @id @default(cuid())
  groupId   String
  inviterId String
  inviteeId String
  role      CommunityGroupRole             @default(MEMBER)
  status    CommunityGroupInvitationStatus @default(PENDING)
  message   String?

  group   CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  inviter User           @relation("CommunityGroupInvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee User           @relation("CommunityGroupInvitationInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  respondedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([groupId])
  @@index([inviteeId, status])
  @@index([inviterId])
  @@index([status])
  @@index([createdAt])
}

model CommunityGroupMessage {
  id                 String                    @id @default(cuid())
  groupId            String
  authorId           String
  type               CommunityGroupMessageType @default(TEXT)
  content            String
  attachmentUrl      String?
  attachmentName     String?
  attachmentMimeType String?
  editedAt           DateTime?
  deletedAt          DateTime?

  group  CommunityGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  author User           @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([groupId, createdAt])
  @@index([authorId])
  @@index([deletedAt])
}
